# ==================== LLM（硅基流动）====================
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
MODEL_NAME=Qwen/Qwen3-8B

# ==================== 思考（思维链）参数 ====================
# Qwen3 这类混合推理模型默认会先写一大段思考再回答。在工具调用场景下，
# 思考能占到输出 token 的 95%（一轮只调个 read_file 却能生成 700+ token），
# 这是生成慢的主因，但直接关掉会让模型失去规划能力（实测会一路拉新闻、不收手写文件）。
# 所以默认保留思考，只给它一个预算上限。
ENABLE_THINKING=true

# 思考预算（token），设 0 表示不限制。
# 实测同一句问题：预算 100 → 6.7 秒，预算 200 → 10.8 秒，不限制 → 17.9 秒。
THINKING_BUDGET=100

# ==================== CORS ====================
# 允许跨域的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
